# Copy to .env and adjust. NEVER commit .env.
# NOTE: default DB points at the Jetson dev host's walker-owned Postgres 16
# (127.0.0.1:5434, started via `make db-start`). On generic hosts, use
# `make up` (docker compose) and set DB_PORT=5432.
DB_NAME=mtaani
DB_USER=mtaani
DB_PASSWORD=mtaani_dev
DB_HOST=127.0.0.1
DB_PORT=5434
SECRET_KEY=insecure-dev-key-change-me
DEBUG=1
